# ============================================================
#  MyPet - 仓库排除清单
#  只提交源码 / 可复现的构建配置 / 文档 / 必要素材；
#  本机路径、环境、凭证、构建产物、会话记录一律不入库。
# ============================================================

# ---- 本地开发环境（SDK / 虚拟环境 / 缓存）----
/dev/

# ---- 构建产物与交付物 ----
/dist/
/build/
/mypet/build/
/mypet/.dart_tool/
/mypet/windows/flutter/ephemeral/
/mypet/android/.gradle/
/mypet/android/build/
/mypet/android/app/debug/
/mypet/android/app/profile/
/mypet/android/app/release/

# ---- 本机绝对路径 / 生成文件 ----
**/local.properties
mypet/.flutter-plugins-dependencies

# ---- 敏感凭证（绝不入库）----
**/key.properties
*.jks
*.keystore
google-services.json
*.pem

# ---- 本机环境脚本与 IDE 配置 ----
/tools/setup_env.bat
/mypet/.idea/
**/*.iml
/.vscode/

# ---- 会话 / 企划 / 报告类文档 ----
/.zcode/

# ---- 日志、临时文件与用户测试素材 ----
*.log
*.tmp
/sounds/
*.mp4
/*.png
/*.jpg

# ---- 系统文件 ----
Thumbs.db
desktop.ini
.DS_Store
